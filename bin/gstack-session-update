#!/usr/bin/env bash
# gstack-session-update — DISABLED in the Thanx fork.
#
# Upstream gstack registered this as a Claude Code SessionStart hook in team
# mode. It silently `git pull`ed from upstream on every session start. That
# bypasses any review of incoming code and is the exact supply-chain risk
# this fork is designed to eliminate.
#
# In this fork:
#   - `setup --team` no longer registers this script as a hook.
#   - Updates happen explicitly via /gstack-upgrade (origin = thanx-ai/gstack)
#     or /upstream-sync (security-reviewed merge from upstream).
#
# This stub stays in place only so any pre-existing SessionStart hook entry
# from a previous install exits cleanly without doing anything. Re-run
# `./setup --no-team` (or remove the SessionStart hook from
# ~/.claude/settings.json by hand) to take it out of the hook list entirely.

exit 0
