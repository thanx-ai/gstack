#!/usr/bin/env bash
# gstack-telemetry-sync — DISABLED in the Thanx fork.
#
# Upstream gstack POSTed local skill-usage JSONL to a public Supabase project
# (https://frugpmstpnojnhfyimgv.supabase.co) on every skill completion. That
# project is not Thanx-controlled, so even sanitized telemetry would send
# Thanx workflow metadata to a third party.
#
# In this fork:
#   - The first-run telemetry opt-in prompt is removed
#     (scripts/resolvers/preamble/generate-telemetry-prompt.ts returns '').
#   - The Supabase config carrying the project URL is deleted (supabase/).
#   - bin/gstack-telemetry-log still writes a local JSONL for inspection,
#     but the sync step is a no-op.
#
# Defense in depth: even if a future change re-enables the opt-in prompt,
# this stub guarantees no network egress to a non-Thanx host.
#
# If you need to reintroduce telemetry for Thanx, do it via /upstream-sync
# and point GSTACK_SUPABASE_URL at a Thanx-controlled host.

exit 0
