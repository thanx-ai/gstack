#!/usr/bin/env bash
# gstack-update-check — DISABLED in the Thanx fork.
#
# Upstream gstack polled https://raw.githubusercontent.com/garrytan/gstack/main/VERSION
# on every skill invocation and emitted UPGRADE_AVAILABLE so skill preambles
# could auto-upgrade. That's a supply-chain attack surface we don't want.
#
# In this fork:
#   - Skill preambles do not call this script (see scripts/resolvers/preamble.ts).
#   - /gstack-upgrade pulls from origin (thanx-ai/gstack), not from upstream.
#   - /upstream-sync handles merging from upstream (garrytan/gstack) with an
#     explicit, file-by-file security review.
#
# This stub stays in place only so any out-of-tree caller exits cleanly with
# no output. Do not reintroduce the network fetch.

exit 0
